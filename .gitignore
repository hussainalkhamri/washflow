# Dependencies
node_modules/
vendor/
frontend/node_modules/
backend/vendor/
backend/node_modules/

# Production build outputs
dist/
frontend/dist/
backend/public/build/
backend/public/hot/
backend/public/storage

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Local Databases & SQLite
*.sqlite
*.sqlite3
*.sqlite-journal
backend/database/*.sqlite

# Logs & Debug
*.log
backend/storage/logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System & OS Files
.DS_Store
Thumbs.db

# Laravel Specific
backend/storage/*.key
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/.phpunit.result.cache
backend/.phpunit.cache
backend/auth.json
backend/_ide_helper.php
